# Set a LangSmith key with deployment access for local standalone use.
LANGSMITH_API_KEY=
# Production standalone deployments require the appropriate license.
LANGGRAPH_CLOUD_LICENSE_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=bmad-langgraph-agent
# Only needed when replacing the deterministic executor with an OpenAI model.
OPENAI_API_KEY=
# Generate a URI-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=
# docker-compose.yml supplies DATABASE_URI and REDIS_URI on its private network.
